Camera {
	position: [0,1,-10]
	orientation: [0,-0.25,1]
	fov: 90
}


Light {
	type: positional
	source: [8,12,-12]
	color: [1,1,1]
	ambient: 0.1
	diffuse: 0.9
	specular: 0.9
}

Sphere {
	position: [0,0,0]
	diameter: 2.0
	Material {
		color: [1,0,1]
		Pattern {
			type: perlin
			second_color: [1,1,0]
			orientation: [0,1,0]
			parameter: 10
		}
	}
}

Sphere {
	position: [-4,0,0]
	diameter: 2.0
	Material {
		color: [1,0,1]
		Pattern {
			type: stripe
			second_color: [1,1,0]
			orientation: [0,1,0]
			parameter: 0.2
		}
	}
}

Sphere {
	position: [4,0,0]
	diameter: 2.0
	Material {
		color: [1,0,1]
		Texture {
			texture_file: textures/earth.jpg
			orientation: [0,1,0]
			scale: 10.0
		}
	}
}


Plane {
	position: [0, -5, 0]
	orientation: [0,1,0]
	Material {
		color: [0,1,0]
		ambient: 0.9
		reflection: 0.0
		Pattern {
			type: stripe
			second_color: [1,0,1]
			orientation: [0,1,0]
			parameter: 10
		}
	}
}