Camera {
	position: [0,1,-10]
	orientation: [0,-0.25,1]
	fov: 90
}


Light {
	type: positional
	source: [8,12,-12]
	color: [1,1,1]
	ambient: 0.1
	diffuse: 0.9
	specular: 0.9
}

Torus {
	position: [0,0,0]
	Material {
		color: [0,1,0]
	}
	orientation: [0,1,0]
	A: 5.0
	B: 2.0
}

Torus {
	position: [15,0,0]
	Material {
		color: [0,1,0]
		Pattern {
			type: stripe
			parameter: 2.0
			second_color: [1,1,0]
			orientation: [1,0,1]
		}
		Texture {
			texture_file: textures/flag2.jpg
			orientation: [0,1,0]
			scale: 3.0
		}
	}
	orientation: [0,1,0]
	A: 5.0
	B: 2.0
}

Torus {
	position: [-15,0,0]
	Material {
		color: [0,1,0]
	}
	orientation: [0,1,0]
	A: 5.0
	B: 2.0
}

Torus {
	position: [-30, 0, 0]
	Material: {
		reflection: 1.0
		color: [0,1,0]
	}
	orientation: [1,1,0]
	A: 5.0
	B: 2.0
}

Plane {
	position: [0, -5, 0]
	orientation: [0,1,0]
	Material {
		color: [0,1,0]
		ambient: 0.9
		reflection: 0.0
		Pattern {
			type: stripe
			second_color: [1,0,1]
