
Camera {
    position: [0,1,-10]
    orientation: [0,-0.25,1]
    fov: 90
}



Light {
    type: directional
    source: [1,-1,0]
    color: [1,1,1]
    ambient: 0.1
    diffuse: 0.9
    specular: 0.9
}

Torus {
    position: [0,0,0]
    orientation: [1,0,0]
    A: 2.0
    B: 1.0
    Material {
        color: [1,0,1]
    }
}

Union {
    Torus {
        position: [0,0,0]
        orientation: [1,0,0]
        A: 2.0
        B: 1.0
        Material {
            color: [1,0,1]
        }
    }
    Cylinder {
        position: [0,-0.1,0]
        orientation: [0,1,0]
        diameter: 40
        height: 0.2
        Material {
            color: [0.25,0.25,0.3]
        }
    }
}


