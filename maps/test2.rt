
Camera {
    position: [0,1,-10]
    orientation: [0,-0.25,1]
    fov: 90
}


Light {
    position: [-8,12,-12]
    color: [1,1,1]
    ambient: 0.1
    diffuse: 0.9
    specular: 0.9
}

Cone {
    position: [0,2.5,0]
    orientation: [0,1,0]
    size: 2
    diameter: 2
    Material {
        color: [1,0,0]
        ambient: 0.9
        Pattern {
            type: gradient
            second_color: [1,1,1]
            parameter: 0.5
            orientation: [0,1,0]
        }
    }
}

Sphere {
    position: [-5, 2, 0.0]
    diameter: 1.0
    Material {
        color: [1.0, 0, 0]
        ambient: 0.9
        Pattern {
            type: gradient
            second_color: [0,0,1]
            orientation: [1,1,0]
            parameter: 1.5
        }
    }
}

Plane {
    position: [0, 0, 0]
    orientation: [0,1,0]
    Material {
        color: [1,0,1]
        ambient: 0.9
        Pattern {
            second_color: [0,1,0]
            type: gradient
            parameter: 1000
            orientation: [1,1,1]
        }
    }
}