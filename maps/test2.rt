
Camera {
    position: [0,1,-10]
    orientation: [0,-0.25,1]
    fov: 90
}


Light {
    position: [-8,12,-12]
    color: [1,1,1]
    ambient: 0.1
    diffuse: 0.9
    specular: 0.9
}

Light {
    position: [8,12,-12]
    color: [1,1,1]
    ambient: 0.1
    diffuse: 0.9
    specular: 0.9
}


Cylinder {
    position: [0,2.5,0]
    orientation: [0,1,0]
    diameter: 2
    height: 2
        Material {
        color: [1,0,0]
        ambient: 0.9
        reflection: 0
        Pattern {
            type: checker
            second_color: [1,1,1]
            parameter: 0.25
            orientation: [1,0,0]
        }
    }
}

Cylinder {
    position: [0,5,0]
    orientation: [0.5,1,0]
    diameter: 2
    height: 2
        Material {
        reflection: 0
        color: [1,0,0]
        ambient: 0.9
        Pattern {
            type: checker
            second_color: [1,1,1]
            parameter: 0.25
            orientation: [1,0,0]
        }
    }
}

Sphere {
    position: [-5, 2, 0.0]
    diameter: 1.0
    Material {
        color: [1.0, 0, 0]
        reflection: 0
        ambient: 0.9
        Pattern {
            type: gradient
            second_color: [0,0,1]
            orientation: [0,1,0]
            parameter: 1.0
        }
        Texture {
            texture_file: whatever.jpeg
            orientation: [0,1,0]
        }
    }
}

Plane {
    position: [0, 0, 0]
    orientation: [0,1,0]
    Material {
        color: [0,1,0]
        reflection: 1.0
        ambient: 0.9
        Pattern {
            type: stripe
            second_color: [1,0,0]
            orientation: [0,1,0]
            parameter: 10
        }
    }
}